{
  "id": "wfTareaUrgente01",
  "name": "Workflow 1: Tarea Urgente",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "evento-tarea",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        200
      ],
      "id": "webhook-node",
      "name": "Webhook"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.body.tarea.prioridad }}",
              "rightValue": "alta",
              "operator": {
                "type": "string",
                "operation": "equals",
                "name": "filter.operator.equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        300,
        200
      ],
      "id": "if-node",
      "name": "If"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"mensaje\": \"Da un consejo breve para gestionar esta tarea urgente: '{{ $node.Webhook.json.body.tarea.titulo }}'\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        500,
        100
      ],
      "id": "http-node",
      "name": "HTTP Request"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "urgente",
              "value": "=true",
              "type": "boolean"
            },
            {
              "name": "consejo",
              "value": "={{ $json.respuesta }}",
              "type": "string"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        750,
        100
      ],
      "id": "set-true-node",
      "name": "Set True"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "name": "urgente",
              "value": "=false",
              "type": "boolean"
            },
            {
              "name": "consejo",
              "value": "",
              "type": "string"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        750,
        300
      ],
      "id": "set-false-node",
      "name": "Set False"
    },
    {
      "parameters": {
        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "name": "timestamp",
              "value": "={{ new Date().toISOString() }}",
              "type": "string"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1000,
        200
      ],
      "id": "set-timestamp-node",
      "name": "Set Timestamp"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, urgente: $json.urgente, consejo: $json.consejo }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1200,
        200
      ],
      "id": "respond-node",
      "name": "Respond to Webhook"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "If",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Set False",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request": {
      "main": [
        [
          {
            "node": "Set True",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set True": {
      "main": [
        [
          {
            "node": "Set Timestamp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set False": {
      "main": [
        [
          {
            "node": "Set Timestamp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Timestamp": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
