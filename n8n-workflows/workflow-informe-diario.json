{
  "id": "wfInformeDiario3",
  "name": "Workflow 3: Daily Executive Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "hours": 9
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        100,
        200
      ],
      "id": "schedule-trigger-node",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trigger-informe",
        "responseMode": "lastNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        100,
        350
      ],
      "id": "webhook-trigger-node",
      "name": "Webhook"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:8000/tareas?completada=false",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        300,
        200
      ],
      "id": "http-get-tasks-node",
      "name": "HTTP Request - Get Tasks"
    },
    {
      "parameters": {
        "jsCode": "const tareas = $input.all().map(i => i.json);\nconst porPrioridad = tareas.reduce((acc, t) => {\n  acc[t.prioridad] = (acc[t.prioridad] || 0) + 1;\n  return acc;\n}, {});\nconst porPrioridadStr = Object.entries(porPrioridad).map(([k, v]) => k + ': ' + v).join(', ');\nreturn [{ json: { total: tareas.length, porPrioridad, porPrioridadStr } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        200
      ],
      "id": "code-group-node",
      "name": "Code"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"mensaje\": \"Genera un informe diario ejecutivo en 3 párrafos. Tareas pendientes: {{ $json.total }}. Por prioridad: {{ $json.porPrioridadStr }}. Incluye una recomendación de acción.\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        700,
        200
      ],
      "id": "http-chat-node",
      "name": "HTTP Request - Chat Report"
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst stats = $node[\"Code\"] ? $node[\"Code\"].json : {};\nconst entrada = {\n  fecha: new Date().toISOString(),\n  informe: $json.informe || $json.respuesta || $json,\n  stats: stats\n};\nfs.appendFileSync('informes.jsonl', JSON.stringify(entrada) + '\\n');\nreturn [{ json: { guardado: true } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        200
      ],
      "id": "code-save-node",
      "name": "Code - Save to File"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "HTTP Request - Get Tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook": {
      "main": [
        [
          {
            "node": "HTTP Request - Get Tasks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Get Tasks": {
      "main": [
        [
          {
            "node": "Code",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code": {
      "main": [
        [
          {
            "node": "HTTP Request - Chat Report",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "HTTP Request - Chat Report": {
      "main": [
        [
          {
            "node": "Code - Save to File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
